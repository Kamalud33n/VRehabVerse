# Local docker-compose (uses the `db` service, no root password needed here directly)
DB_ROOT_PASSWORD=changeme

# App reads this to connect. For docker-compose, host must be "db" not "localhost".
DATABASE_URL=mysql+pymysql://root:changeme@db:3306/mednova_vr_db?charset=utf8mb4

# Optional: seed demo data on first startup
SEED_DEMO_DATA=false

# Mail (Gmail SMTP example - use a Gmail "App Password", not your real password)
# 1. Turn on 2-Step Verification on the Gmail account
# 2. Go to https://myaccount.google.com/apppasswords and create an App Password
# 3. Put that 16-char password below as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your16charapppassword
MAIL_FROM=youraddress@gmail.com
MAIL_FROM_NAME=MedNova VR
